{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.cenner.hr"
        }
      ],
      "destination": "https://cenner.hr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cenner.hr"
        }
      ],
      "destination": "https://cenner.hr/:path*",
      "permanent": true
    },
    {
      "source": "/match",
      "destination": "/marketplace#ai-matching",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/saved",
      "destination": "/profile?tab=saved",
      "permanent": true
    },
    {
      "source": "/blog-admin",
      "destination": "/admin/blog",
      "permanent": true
    },
    {
      "source": "/blog-admin/:id",
      "destination": "/admin/blog/:id",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/blog",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/about#kontakt",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/services#radovi",
      "permanent": true
    },
    {
      "source": "/technology",
      "destination": "/services#alati",
      "permanent": true
    },
    {
      "source": "/earnings",
      "destination": "/profile?tab=earnings",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/service/:id",
      "destination": "/api/render?type=service&id=:id"
    },
    {
      "source": "/freelancer/:id",
      "destination": "/api/render?type=freelancer&id=:id"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/render?type=blog&id=:slug"
    },
    {
      "source": "/(profile|creator-onboarding|banned|orders|messages|contracts|reset-password|verify-email|order-success|referral)",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/(messages|contracts|checkout|checkout-subscription)/:id",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?type=notfound"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "staging.cenner.hr" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/usluge/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/freelanceri/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
