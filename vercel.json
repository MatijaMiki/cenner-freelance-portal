{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.cenner.hr"
        }
      ],
      "destination": "https://cenner.hr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cenner.hr"
        }
      ],
      "destination": "https://cenner.hr/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/service/:id",
      "destination": "/api/render?type=service&id=:id"
    },
    {
      "source": "/freelancer/:id",
      "destination": "/api/render?type=freelancer&id=:id"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/render?type=blog&id=:slug"
    },
    {
      "source": "/(profile|creator-onboarding|blog-admin|banned|dashboard|orders|messages|contracts|projects|reset-password|earnings|saved|onboarding|order-success|referral)",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/admin/bans",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/(blog-admin|messages|contracts|checkout|checkout-subscription)/:id",
      "destination": "/api/render?type=private"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?type=notfound"
    }
  ],
  "headers": [
    {
      "source": "/usluge/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/freelanceri/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
